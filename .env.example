# Optional. Without credentials, use the explicitly fictional demo mode.
TAVILY_API_KEY=
OPENAI_API_KEY=
# Checked against the OpenAI models endpoint at admission; no silent fallback.
OPENAI_MODEL=gpt-4.1-mini
# Set conservative ceilings based on your account's pricing before live use.
# These are per-call reservations, not measured prices. Successful calls are
# charged at the full configured ceiling in the local ledger.
TAVILY_MAX_CALL_USD=
OPENAI_MAX_CALL_USD=
PORT=3001
DATA_DIR=.data
